# ==========================================
# EazyFi Agent Portal - Environment Variables
# ==========================================

# ------------------------------------------
# Supabase
# ------------------------------------------

SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key
# Safe for server authentication operations that
# use the publishable client.
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supabase secret key
# SERVER ONLY - NEVER expose this in frontend code.
SUPABASE_SECRET_KEY=your_secret_key_here


# ------------------------------------------
# Authentication
# ------------------------------------------

# Used to sign the EazyFi server session.
# Use a long random value in the real environment.
SESSION_SECRET=your_long_random_session_secret_here


# ------------------------------------------
# Administrator
# ------------------------------------------

# Used by protected /api/admin/* endpoints.
# SERVER ONLY - NEVER place this in frontend code.
ADMIN_API_KEY=your_admin_api_key_here


# ------------------------------------------
# Paystack
# ------------------------------------------

# SERVER ONLY
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here


# ------------------------------------------
# mNotify
# ------------------------------------------

# SERVER ONLY
MNOTIFY_API_KEY=your_mnotify_api_key_here

# Sender ID used when sending voucher SMS.
MNOTIFY_SENDER_ID=EazyFi
